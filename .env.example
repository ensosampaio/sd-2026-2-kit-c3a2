# Copie para .env (cp .env.example .env). O .env esta no .gitignore: NUNCA o versione.
# Sem .env, a plataforma sobe em modo desenvolvimento (credenciais padrao + aviso nos logs).

# --- Ambiente: "production" recusa subir com segredo/senha fracos ---
AMBIENTE=development

# --- Autenticacao (JWT) ---
# Producao: JWT_SEGREDO com 32+ caracteres (ex.: openssl rand -hex 32),
# SENHA_API com 12+ caracteres e USUARIO_API diferente de "admin".
JWT_SEGREDO=troque-este-segredo
USUARIO_API=admin
SENHA_API=troque-esta-senha
JWT_EXPIRA_MINUTOS=30
LIMITE_POR_MINUTO=30

# --- Resiliencia do gateway -> inferencia ---
TIMEOUT_INFERENCIA_SEGUNDOS=5
TENTATIVAS_GET=3
CB_LIMITE_FALHAS=5
CB_ESPERA_SEGUNDOS=20

# --- Privacidade (LGPD): resultados expiram sozinhos no Redis ---
RESULTADO_TTL_SEGUNDOS=86400

# --- Observabilidade: otlp (Collector) | console | none ---
OTEL_TRACES_EXPORTER=otlp

# --- Deploy com HTTPS (docker compose --profile https up -d) ---
DOMINIO=localhost
GATEWAY_BIND=0.0.0.0
CONFIAR_PROXY=false
